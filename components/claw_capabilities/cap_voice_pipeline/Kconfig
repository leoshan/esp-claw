menu "Voice Pipeline Capability Configuration"

config CLAW_CAP_VOICE_PIPELINE_ENABLED
    bool "Enable Voice Pipeline Capability"
    default y
    help
        Enables the I2S hardware audio pipeline with Volcengine SenseVoice ASR
        and TTS.

        This capability drives I2S directly on the pins configured below and
        does not go through the board manager / esp_codec_dev abstraction, so
        it must only be enabled on boards whose pins are known to be free.
        Leave it disabled on boards that already assign those pins to a codec,
        display or other peripheral.

if CLAW_CAP_VOICE_PIPELINE_ENABLED

comment "Microphone (I2S RX) pins"

config CLAW_CAP_VOICE_MIC_GPIO_WS
    int "Microphone I2S WS (LRCK) GPIO"
    default 4

config CLAW_CAP_VOICE_MIC_GPIO_SCK
    int "Microphone I2S SCK (BCLK) GPIO"
    default 5

config CLAW_CAP_VOICE_MIC_GPIO_DIN
    int "Microphone I2S DIN GPIO"
    default 6

config CLAW_CAP_VOICE_MIC_SAMPLE_RATE
    int "Microphone capture sample rate (Hz)"
    default 16000
    help
        Must match the sample rate declared in the WAV header sent to the ASR
        service.

comment "Speaker (I2S TX) pins"

config CLAW_CAP_VOICE_SPK_GPIO_DOUT
    int "Speaker I2S DOUT GPIO"
    default 7

config CLAW_CAP_VOICE_SPK_GPIO_BCLK
    int "Speaker I2S BCLK GPIO"
    default 15

config CLAW_CAP_VOICE_SPK_GPIO_LRCK
    int "Speaker I2S LRCK (WS) GPIO"
    default 16

config CLAW_CAP_VOICE_SPK_SAMPLE_RATE
    int "Speaker playback sample rate (Hz)"
    default 24000
    help
        Must match the sample rate requested from the TTS service.

comment "Recording behaviour"

config CLAW_CAP_VOICE_RECORD_DURATION_SEC
    int "Maximum recording duration per utterance (seconds)"
    default 4
    range 1 15
    help
        The PCM capture buffer is sized from this value:
        sample_rate * 2 bytes * duration. Four seconds at 16 kHz is 128 KB.

endif

endmenu
