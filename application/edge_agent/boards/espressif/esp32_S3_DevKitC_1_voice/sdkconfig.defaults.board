CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# This DevKitC-1 carries 16MB of SPI flash. Building for 8MB left half the
# chip unused and made the bootloader log
# "Detected size(16384k) larger than the size in the binary image header".
#
# tools/cmake/flash_partition_defaults.cmake reads this flash size and
# auto-selects partitions_16MB.csv, so do not set PARTITION_TABLE_* here.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# I2S peripherals declared in board_peripherals.yaml (mic + speaker)
CONFIG_ESP_BOARD_PERIPH_I2S_SUPPORT=y

# The MAX98357A is a bare I2S amplifier with no control interface, so the
# board manager builds its audio_dac device on the "dummy" codec. Without this
# the codec registry has no such entry and boot logs
#   E DEV_AUDIO_CODEC: Unsupported codec: dummy
#   E BOARD_DEVICE: Failed to init device: audio_dac
CONFIG_CODEC_DUMMY_SUPPORT=y

# Voice pipeline: ASR/TTS over the board-managed I2S mic and speaker
CONFIG_CLAW_CAP_VOICE_PIPELINE_ENABLED=y

# transport_ws uses this one buffer for BOTH the WebSocket upgrade request and
# the handshake response headers. The default 1024 is too small for the
# Volcengine ASR endpoint: its gateway returns enough tracing headers that the
# \r\n\r\n terminator lands past the end, and the handshake fails with
# "Header size exceeded buffer size or delimiter not found".
# Note esp_websocket_client_config_t.buffer_size is a different buffer (frame
# payloads) and does not affect this.
CONFIG_WS_BUFFER_SIZE=4096

# Wireless push-to-talk over BLE.
#
# The project default (application/edge_agent/sdkconfig.defaults) turns the
# central and observer roles off, which only leaves the peripheral side: the
# device could pretend to BE a keyboard but could never scan for or connect to
# one. A HID button needs the opposite direction, so re-enable them here.
CONFIG_CLAW_CAP_BLE_TRIGGER_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_GATT_CLIENT=y

# esp_hid's nimble_hidh.c is compiled to an empty translation unit without
# this: the whole file sits behind #if CONFIG_BT_NIMBLE_HID_SERVICE.
CONFIG_BT_NIMBLE_HID_SERVICE=y

# Two links at once: the phone (or another GATT client) on the peripheral side
# and the HID button on the central side. The project default of 1 would let
# whichever connected first lock the other out.
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2
CONFIG_BT_NIMBLE_MAX_BONDS=4
CONFIG_BT_NIMBLE_MAX_CCCDS=4
